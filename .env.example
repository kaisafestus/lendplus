# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional. Base URL for backend API in production deployments.
# Example: https://lendplus-api.onrender.com
VITE_API_BASE_URL=""

# UPESIPAY GATEWAY CONFIGURATION
# Get these values from your UpesiPay account. Never commit real credentials.
UPESIPAY_BASIC_AUTH="Basic BASE64_OF_API_USERNAME_COLON_API_PASSWORD"
UPESIPAY_CHANNEL_ID="YOUR_REGISTERED_CHANNEL_ID"
UPESIPAY_CALLBACK_URL="https://your-domain.vercel.app/api/upesipay/callback"
# Official documented endpoints. Override only if UpesiPay explicitly instructs you to.
UPESIPAY_STK_PUSH_URL="https://upesipay.com/api/v2/collections/initiate/"
UPESIPAY_STATUS_URL="https://upesipay.com/api/v2/transaction-status"
